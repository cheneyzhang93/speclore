{
  "name": "speclore",
  "version": "0.1.0",
  "description": "AI-powered product-engineering collaboration CLI tool. Turn requirements into BDD specs, auto-generate AI coding constraints, and verify acceptance criteria.",
  "keywords": [
    "ai",
    "bdd",
    "cucumber",
    "gherkin",
    "mcp",
    "cursor",
    "claude",
    "specification",
    "acceptance-testing",
    "requirement-management"
  ],
  "homepage": "https://github.com/nicepkg/speclore#readme",
  "bugs": {
    "url": "https://github.com/nicepkg/speclore/issues"
  },
  "license": "MIT",
  "author": "Cheney",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "speclore": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/cli/templates",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').cpSync('src/cli/templates','dist/cli/templates',{recursive:true})\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postuninstall": "node scripts/cleanup-global.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@cucumber/gherkin": "^30.0.0",
    "@cucumber/messages": "^27.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "exceljs": "^4.4.0",
    "glob": "^11.0.1",
    "inquirer": "^12.5.0",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.8.0",
    "openai": "^4.86.0",
    "ora": "^8.2.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.4",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.8.0"
}
